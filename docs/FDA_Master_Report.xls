<Row>
<Cell ss:StyleID="data"><Data ss:Type="Number">1</Data></Cell>
<Cell ss:StyleID="drugName"><Data ss:Type="String">CIBINQO</Data></Cell>
<Cell ss:StyleID="data"><Data ss:Type="String">ABROCITINIB</Data></Cell>
<Cell ss:StyleID="data"><Data ss:Type="String">Dermatology</Data></Cell>
<Cell ss:StyleID="data"><Data ss:Type="String">09/02/2026</Data></Cell>
