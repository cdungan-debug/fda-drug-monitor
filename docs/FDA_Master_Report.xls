<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet">
<Styles>
<Style ss:ID="Default" ss:Name="Normal">
<Font ss:FontName="Calibri" ss:Size="11"/>
<Alignment ss:Vertical="Center" ss:WrapText="1"/>
</Style>
<Style ss:ID="title"><Font ss:FontName="Calibri" ss:Size="18" ss:Bold="1" ss:Color="#FFFFFF"/><Interior ss:Color="#0078D4" ss:Pattern="Solid"/><Alignment ss:Vertical="Center"/></Style>
<Style ss:ID="subtitle"><Font ss:FontName="Calibri" ss:Size="12" ss:Color="#FFFFFF"/><Interior ss:Color="#0078D4" ss:Pattern="Solid"/><Alignment ss:Vertical="Center"/></Style>
<Style ss:ID="section"><Font ss:FontName="Calibri" ss:Size="13" ss:Bold="1" ss:Color="#0078D4"/><Alignment ss:Vertical="Center"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#0078D4"/></Borders></Style>
<Style ss:ID="header"><Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#FFFFFF"/><Interior ss:Color="#0078D4" ss:Pattern="Solid"/><Alignment ss:Vertical="Center" ss:WrapText="1"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#005A9E"/></Borders></Style>
<Style ss:ID="data"><Font ss:FontName="Calibri" ss:Size="11"/><Alignment ss:Vertical="Center" ss:WrapText="1"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E0E0E0"/></Borders></Style>
<Style ss:ID="dataAlt"><Font ss:FontName="Calibri" ss:Size="11"/><Interior ss:Color="#F2F7FC" ss:Pattern="Solid"/><Alignment ss:Vertical="Center" ss:WrapText="1"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E0E0E0"/></Borders></Style>
<Style ss:ID="drugName"><Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#333333"/><Alignment ss:Vertical="Center"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E0E0E0"/></Borders></Style>
<Style ss:ID="drugNameAlt"><Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#333333"/><Interior ss:Color="#F2F7FC" ss:Pattern="Solid"/><Alignment ss:Vertical="Center"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E0E0E0"/></Borders></Style>
<Style ss:ID="infoLabel"><Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#555555"/><Alignment ss:Vertical="Center"/></Style>
<Style ss:ID="infoValue"><Font ss:FontName="Calibri" ss:Size="11" ss:Color="#333333"/><Alignment ss:Vertical="Center"/></Style>
<Style ss:ID="countNum"><Font ss:FontName="Calibri" ss:Size="11"/><Alignment ss:Vertical="Center" ss:Horizontal="Center"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E0E0E0"/></Borders></Style>
<Style ss:ID="specGroup"><Font ss:FontName="Calibri" ss:Size="12" ss:Bold="1" ss:Color="#FFFFFF"/><Interior ss:Color="#28A745" ss:Pattern="Solid"/><Alignment ss:Vertical="Center"/></Style>
</Styles>
<Worksheet ss:Name="Summary">
<Table ss:DefaultRowHeight="20">
<Column ss:Width="200"/>
<Column ss:Width="300"/>
<Row ss:Height="40">
<Cell ss:StyleID="title" ss:MergeAcross="1"><Data ss:Type="String">FDA Master Drug Approval Report</Data></Cell>
</Row>
<Row ss:Height="25">
<Cell ss:StyleID="subtitle" ss:MergeAcross="1"><Data ss:Type="String">Northwell Health - Business Operations</Data></Cell>
</Row>
<Row><Cell><Data ss:Type="String"></Data></Cell></Row>
<Row>
<Cell ss:StyleID="infoLabel"><Data ss:Type="String">Last Updated:</Data></Cell>
<Cell ss:StyleID="infoValue"><Data ss:Type="String">Sunday, July 26, 2026 at 02:57 PM</Data></Cell>
</Row>
<Row>
<Cell ss:StyleID="infoLabel"><Data ss:Type="String">Coverage:</Data></Cell>
<Cell ss:StyleID="infoValue"><Data ss:Type="String">July 26, 2024 to July 26, 2026</Data></Cell>
</Row>
<Row>
<Cell ss:StyleID="infoLabel"><Data ss:Type="String">Total Approvals:</Data></Cell>
<Cell ss:StyleID="infoValue"><Data ss:Type="String">0</Data></Cell>
</Row>
<Row>
<Cell ss:StyleID="infoLabel"><Data ss:Type="String">Auto-Updated:</Data></Cell>
<Cell ss:StyleID="infoValue"><Data ss:Type="String">Daily at 9:00 AM EST</Data></Cell>
</Row>
<Row><Cell><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="section" ss:MergeAcross="1"><Data ss:Type="String">Approvals by Submission Type</Data></Cell></Row>
<Row><Cell ss:StyleID="header"><Data ss:Type="String">Type</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">Count</Data></Cell></Row>
<Row><Cell><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="section" ss:MergeAcross="1"><Data ss:Type="String">Approvals by Specialty</Data></Cell></Row>
<Row><Cell ss:StyleID="header"><Data ss:Type="String">Specialty</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">Count</Data></Cell></Row>
<Row><Cell><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="section" ss:MergeAcross="1"><Data ss:Type="String">Top 15 Sponsors</Data></Cell></Row>
<Row><Cell ss:StyleID="header"><Data ss:Type="String">Sponsor</Data></Cell><Cell ss:StyleID="header"><Data ss:Type="String">Count</Data></Cell></Row>
</Table></Worksheet>
<Worksheet ss:Name="All Approvals">
<Table ss:DefaultRowHeight="22">
<Column ss:Width="30"/>
<Column ss:Width="150"/>
<Column ss:Width="180"/>
<Column ss:Width="130"/>
<Column ss:Width="90"/>
<Column ss:Width="140"/>
<Column ss:Width="170"/>
<Column ss:Width="110"/>
<Column ss:Width="120"/>
<Column ss:Width="80"/>
<Column ss:Width="250"/>
<Column ss:Width="400"/>
<Row ss:Height="35">
<Cell ss:StyleID="title" ss:MergeAcross="11"><Data ss:Type="String">FDA Master Report - All Approvals (July 26, 2024 to July 26, 2026)</Data></Cell>
</Row>
<Row ss:Height="30">
<Cell ss:StyleID="header"><Data ss:Type="String">#</Data></Cell>
<Cell ss:StyleID="header"><Data ss:Type="String">Drug Name</Data></Cell>
<Cell ss:StyleID="header"><Data ss:Type="String">Generic Name</Data></Cell>
<Cell ss:StyleID="header"><Data ss:Type="String">Specialty</Data></Cell>
<Cell ss:StyleID="header"><Data ss:Type="String">Approval Date</Data></Cell>
<Cell ss:StyleID="header"><Data ss:Type="String">Submission Type</Data></Cell>
<Cell ss:StyleID="header"><Data ss:Type="String">Sponsor</Data></Cell>
<Cell ss:StyleID="header"><Data ss:Type="String">Application #</Data></Cell>
<Cell ss:StyleID="header"><Data ss:Type="String">Dosage Form</Data></Cell>
<Cell ss:StyleID="header"><Data ss:Type="String">Route</Data></Cell>
<Cell ss:StyleID="header"><Data ss:Type="String">Active Ingredients</Data></Cell>
<Cell ss:StyleID="header"><Data ss:Type="String">Indication</Data></Cell>
</Row>
</Table></Worksheet>
<Worksheet ss:Name="By Specialty">
<Table ss:DefaultRowHeight="22">
<Column ss:Width="150"/>
<Column ss:Width="180"/>
<Column ss:Width="90"/>
<Column ss:Width="140"/>
<Column ss:Width="170"/>
<Column ss:Width="400"/>
<Row ss:Height="35">
<Cell ss:StyleID="title" ss:MergeAcross="5"><Data ss:Type="String">Approvals Grouped by Specialty</Data></Cell>
</Row>
</Table></Worksheet>
</Workbook>